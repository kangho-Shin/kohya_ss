<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PowerMaster</AssemblyName>
    <Product>PowerMaster</Product>
    <Title>PowerMaster</Title>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>../../assets/powermaster.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OfficePower.Core/OfficePower.Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="MainForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="MainForm.Designer.cs"><DependentUpon>MainForm.cs</DependentUpon></Compile>
    <Compile Update="RegistrationForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="RegistrationForm.Designer.cs"><DependentUpon>RegistrationForm.cs</DependentUpon></Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/powermaster.ico" LogicalName="OfficePower.App.ico" />
    <Compile Include="../Shared/AppIcon.cs" Link="AppIcon.cs" />
  </ItemGroup>
</Project>
