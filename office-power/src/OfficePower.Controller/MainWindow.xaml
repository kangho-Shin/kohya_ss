<Window x:Class="OfficePower.Controller.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="사무실 PC 전원 관리" Width="1120" Height="720" MinWidth="900" MinHeight="560" Background="#F3F5F9" Loaded="OnLoaded" Closing="OnClosing">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#182D49" Padding="26,22">
      <StackPanel><TextBlock Text="사무실 PC 전원 관리" Foreground="White" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="등록한 PC를 선택하고 켜거나 끕니다 · 같은 사무실 네트워크 전용" Foreground="#C6D4E6" Margin="0,8,0,0"/></StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="White" Padding="24,18">
      <StackPanel><StackPanel x:Name="PowerBar" Orientation="Horizontal">
        <Button Content="선택 PC 켜기" Click="WakeClick" Background="#17684B" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
        <Button Content="선택 PC 끄기" Click="ShutdownClick" Background="#AC313A" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
      </StackPanel><TextBlock x:Name="StatusText" Text="PC 등록으로 시작하세요. 켜기는 BIOS와 유선 랜카드의 Wake-on-LAN 설정이 필요합니다." TextWrapping="Wrap" Foreground="#40536C" Margin="0,14,0,0"/></StackPanel>
    </Border>
    <DockPanel Margin="24">
      <StackPanel x:Name="Tools" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
        <Button Content="PC 등록" Click="AddClick"/><Button Content="선택 행 수정" Click="EditClick"/><Button Content="선택 행 삭제" Click="DeleteClick"/><Button Content="연결 확인" Click="StatusClick"/>
      </StackPanel>
      <DataGrid x:Name="ComputerGrid" ItemsSource="{Binding Computers}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="44" ColumnHeaderHeight="40" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="55"><DataGridCheckBoxColumn.Header><CheckBox ToolTip="모두 선택" Click="SelectAllClick"/></DataGridCheckBoxColumn.Header></DataGridCheckBoxColumn>
          <DataGridTextColumn Header="PC 이름" Binding="{Binding Name}" Width="170" IsReadOnly="True"/>
          <DataGridTextColumn Header="IP 주소" Binding="{Binding Ip}" Width="150" IsReadOnly="True"/>
          <DataGridTextColumn Header="MAC 주소" Binding="{Binding Mac}" Width="180" IsReadOnly="True"/>
          <DataGridTextColumn Header="최근 요청 / 연결 상태" Binding="{Binding Status}" Width="*" IsReadOnly="True"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </DockPanel>
</Window>
